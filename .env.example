# Salin jadi .env lalu isi. File .env sudah di-gitignore.
#
# PENTING: password boleh dikosongkan. Kalau kosong, script akan minta
# lewat getpass (nggak kelihatan di layar) atau bisa diketik manual di browser.
# Jangan commit .env, jangan share ke siapa pun.

BINUS_EMAIL=
BINUS_PASSWORD=

# Halaman tujuan setelah login berhasil (opsional)
BINUS_LANDING_URL=https://acadservices.apps.binus.ac.id/newstaff/#/index
